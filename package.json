{
  "name": "jinmarket",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:cert": "powershell -ExecutionPolicy Bypass -File scripts/generate-dev-cert.ps1",
    "dev:api": "npm run dev --workspace @jinmarket/api",
    "dev:shop": "npm run dev --workspace @jinmarket/shop-web",
    "dev:admin": "npm run dev --workspace @jinmarket/admin-web",
    "push:vapid": "node scripts/generate-vapid-keys.mjs",
    "build:api": "node scripts/run-workspace-build.mjs api",
    "build:admin-web": "node scripts/run-workspace-build.mjs admin-web",
    "build:shop-web": "node scripts/run-workspace-build.mjs shop-web",
    "build": "node scripts/run-workspace-build.mjs",
    "typecheck": "npm run typecheck --workspace @jinmarket/shared && npm run typecheck --workspace @jinmarket/db && npm run typecheck --workspace @jinmarket/server && npm run typecheck --workspace @jinmarket/api && npm run typecheck --workspace @jinmarket/shop-web && npm run typecheck --workspace @jinmarket/admin-web"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.14",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.2"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.2",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
